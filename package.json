{
  "name": "lan-messenger",
  "productName": "LAN Messenger 2",
  "version": "2.7.0",
  "description": "Fast, secure, serverless messenger for your local network",
  "main": "src/main/boot.js",
  "author": "LAN Messenger 2",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.lanmessenger.v2",
    "productName": "LAN Messenger 2",
    "copyright": "LAN Messenger 2",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LAN Messenger 2",
      "include": "build/installer.nsh",
      "artifactName": "LAN-Messenger-2-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LAN-Messenger-2-Portable-${version}.${ext}"
    },
    "afterPack": "build/after-pack.js"
  }
}
